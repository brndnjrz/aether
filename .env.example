# ── AI Provider ──────────────────────────────────────────────────────────────
# "auto"   → use Claude if key is set, otherwise fall back to Ollama (default)
# "claude" → Claude only
# "ollama" → Ollama only (great for local testing — no key needed)
AI_PROVIDER=auto

# Anthropic / Claude (leave blank to skip, use Ollama instead)
ANTHROPIC_API_KEY=

# Ollama local LLM — install from https://ollama.com, then: ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Optional per-brief overrides — fall back to OLLAMA_MODEL when unset.
# Route judgment-heavy briefs to a larger reasoning model, keep cheap/templated
# ones on something fast. Reasoning models (deepseek-r1:*, deepscaler) need a
# generous token budget to finish thinking before they answer — client.py
# already floors num_predict at 1500 and retries once if one comes back empty.
# OLLAMA_MODEL_STOCK_BRIEF=deepseek-r1:32b
# OLLAMA_MODEL_OPTIONS_BRIEF=deepseek-r1:32b
# OLLAMA_MODEL_DAYTRADING_BRIEF=llama3.2
# OLLAMA_MODEL_THESIS=llama3.2

# ── Optional data sources ─────────────────────────────────────────────────────
ALPHA_VANTAGE_API_KEY=
